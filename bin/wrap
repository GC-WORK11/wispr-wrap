#!/bin/bash
# wrap — Sign-Flow: phone -> laptop input bridge
SELF="$(readlink -f "$0")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
PORT="${WF_PORT:-8741}"
PIDFILE="$ROOT/wfd.pid"
LOG="$ROOT/wfd.log"
TUNLOG="$ROOT/tunnel.log"
TUNPID="$ROOT/tunnel.pid"
CF="${CF:-$(command -v cloudflared 2>/dev/null || echo "$HOME/.local/bin/cloudflared")}"
KEYFILE="$HOME/.config/wf/key"

bound_port() {
    # the port the daemon ACTUALLY bound (falls back when busy) — scraped
    # from its log line, so `wrap` commands work after a port fallback.
    grep -o 'http://0\.0\.0\.0:[0-9]*' "$LOG" 2>/dev/null | tail -1 | grep -o '[0-9]*$'
}
live_port() { local p; p=$(bound_port); echo "${p:-$PORT}"; }
daemon_running() { curl -sf "http://localhost:$(live_port)/health" >/dev/null 2>&1; }
key() { cat "$KEYFILE" 2>/dev/null; }

qr() { python3 "$ROOT/server/qrprint.py" "$1"; }

pair_card() {
    local info
    info=$(curl -sf "http://localhost:$(live_port)/pair-info") || { echo "daemon not answering"; return 1; }
    python3 - "$info" "$ROOT/server/qrprint.py" <<'PY'
import json, sys, subprocess
i = json.loads(sys.argv[1])
link = f"http://{i['ip']}:{i['port']}/?k={i['key']}"
subprocess.run([sys.executable, sys.argv[2], link])
print()
print(f"  scan with your phone camera — composer opens paired")
print(f"  or open on phone:  {link}")
alts = [a for a in i.get('ips', []) if a != i['ip']]
for a in alts:
    print(f"  other interface:   http://{a}:{i['port']}/?k={i['key']}")
print(f"  app/manual:        address {i['ip']}:{i['port']}   code {i['code']}")
PY
}

case "$1" in
start)
    if daemon_running; then echo "daemon already running on :$(live_port)"; else
        : >"$LOG"
        # setsid = own session, < /dev/null = no tty: the daemon survives
        # this terminal closing or the CLI being killed (SIGHUP can't reach it).
        setsid python3 "$ROOT/server/wfd.py" >>"$LOG" 2>&1 </dev/null &
        echo $! > "$PIDFILE"
        for i in $(seq 1 40); do daemon_running && break; sleep 0.25; done
        daemon_running || { echo "daemon failed — see $LOG (wrap logs)"; exit 1; }
        BPORT="$(live_port)"
        [ "$BPORT" != "$PORT" ] && echo "port $PORT busy — using :$BPORT"
    fi
    if adb get-state >/dev/null 2>&1; then
        adb reverse "tcp:8741" "tcp:$(live_port)" && echo "usb bridge: phone localhost:8741 -> laptop :$(live_port)"
    fi
    pair_card
    # firewall hint ONLY when the LAN URL doesn't answer (ufw/firewalld users)
    LIP=$(curl -sf "http://localhost:$(live_port)/pair-info" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("ip",""))' 2>/dev/null)
    if [ -n "$LIP" ] && [ "$LIP" != "127.0.0.1" ] && ! curl -sf --max-time 2 "http://$LIP:$(live_port)/health" >/dev/null 2>&1; then
        echo "firewall: http://$LIP:$(live_port) unreachable from here — likely a firewall."
        echo "          allow it: sudo ufw allow $(live_port)/tcp   (or: sudo firewall-cmd --add-port=$(live_port)/tcp)"
    fi
    ;;
pair)
    pair_card
    ;;
restart)
    "$0" stop; sleep 0.3; "$0" start
    ;;
bridge)
    adb wait-for-device
    adb reverse "tcp:8741" "tcp:$PORT" && echo "usb bridge up: phone localhost:8741 -> laptop :$PORT"
    ;;
stop)
    [ -f "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null && rm -f "$PIDFILE" && echo "daemon stopped"
    [ -f "$TUNPID" ] && kill "$(cat "$TUNPID")" 2>/dev/null && rm -f "$TUNPID" && echo "tunnel stopped"
    adb reverse --remove "tcp:8741" 2>/dev/null
    ;;
status)
    if daemon_running; then
        BP="$(live_port)"
        RSS=$(awk '/VmRSS/{printf "%.1f", $2/1024}' "/proc/$(cat "$PIDFILE" 2>/dev/null)/status" 2>/dev/null)
        LIP=$(curl -sf "http://localhost:$BP/pair-info" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("ip",""))' 2>/dev/null)
        echo "daemon: UP on :$BP (pid $(cat "$PIDFILE" 2>/dev/null), rss ${RSS:-?} MB)"
        [ -n "$LIP" ] && echo "lan:    http://$LIP:$BP/"
    else
        echo "daemon: DOWN"
    fi
    adb devices | tail -n +2 | grep -q device && adb devices || echo "adb: no device"
    adb reverse --list 2>/dev/null | grep . || echo "bridge: none"
    grep -o 'https://[a-z0-9-]*\.trycloudflare\.com' "$TUNLOG" 2>/dev/null | tail -1 | sed 's/^/tunnel: /'
    ;;
logs)
    [ -f "$LOG" ] || { echo "no log yet — run: wrap start"; exit 1; }
    if [ "$2" = "-f" ]; then tail -f "$LOG"; else tail -50 "$LOG"; fi
    ;;
send|test)
    shift; text="$*"; [ -z "$text" ] && text="hello from wrap $(date +%T)"
    curl -sf -X POST "http://localhost:$(live_port)/send" -H "Content-Type: application/json" \
        -H "X-WF-Key: $(key)" \
        -d "$(python3 -c 'import json,sys; print(json.dumps({"text": sys.argv[1], "mode": "type"}))' "$text")" \
        && echo " -> typed at cursor"
    ;;
install)
    "$ROOT/app/build.sh" && adb install -r "$ROOT/app/wf-composer.apk" && \
        adb shell am start -n com.wf.composer/.MainActivity
    ;;
tunnel)
    command -v "$CF" >/dev/null || { echo "cloudflared not found (set \$CF or install it)"; exit 1; }
    [ -f "$TUNPID" ] && kill "$(cat "$TUNPID")" 2>/dev/null; rm -f "$TUNPID"; sleep 0.5
    nohup "$CF" tunnel --url "http://localhost:$PORT" --no-autoupdate >"$TUNLOG" 2>&1 &
    echo $! > "$TUNPID"
    echo -n "waiting for tunnel"
    for i in $(seq 1 30); do
        TURL=$(grep -o 'https://[a-z0-9-]*\.trycloudflare\.com' "$TUNLOG" | tail -1)
        [ -n "$TURL" ] && break; echo -n "."; sleep 1
    done; echo
    [ -z "$TURL" ] && { echo "tunnel failed — see $TUNLOG"; exit 1; }
    echo "tunnel: $TURL"
    qr "$TURL/?k=$(key)"
    echo "  scan with your phone camera — works from anywhere"
    ;;
open)
    adb shell am start -n com.wf.composer/.MainActivity
    ;;
doctor|check)
    python3 - <<'PY'
import os, shutil, subprocess, sys
def have(c): return shutil.which(c) is not None
def pyxlib():
    try:
        import Xlib; return True
    except Exception:
        return False
req = [("python3", have("python3"), "the daemon itself"),
       ("curl",    have("curl"),    "CLI talks to the daemon over HTTP"),
       ("xdotool", have("xdotool"), "types/pastes at the cursor"),
       ("xprop",   have("xprop"),   "active-window detection (x11-utils)"),
       ("xclip",   have("xclip"),   "clipboard save/restore"),
       ("convert", have("convert"), "image -> png normalization (imagemagick)"),
       ("python3-xlib", pyxlib(),   "multi-target clipboard (apt: python3-xlib)")]
opt = [("adb",         have("adb"),        "usb bridge + app install"),
       ("cloudflared", have("cloudflared"), "wrap tunnel — anywhere access"),
       ("scrcpy",      have("scrcpy"),      "phone screen mirroring"),
       ("notify-send", have("notify-send"), "confirm prompts for riskier signed actions")]
bad = 0
print("wrap doctor — dependency check")
try:
    ufw = open("/etc/ufw/ufw.conf").read()
    if "ENABLED=yes" in ufw:
        print(f"  [ note  ] ufw is ON — LAN pairing needs: sudo ufw allow 8741/tcp")
except OSError:
    pass
for name, ok, why in req:
    print(f"  [{'ok' if ok else 'MISSING'}] {name:<13} {why}")
    bad += 0 if ok else 1
for name, ok, why in opt:
    print(f"  [{'ok' if ok else ' - '}] {name:<13} {why} (optional)")

# session + runtime — injection is X11-only; say so before it fails silently
def env(tag, name, why): print(f"  [{tag}] {name:<13} {why}")
sess = os.environ.get("XDG_SESSION_TYPE", "").lower()
disp = os.environ.get("DISPLAY", "")
if sess == "wayland":
    env("warn", "session", "wayland — xdotool/xclip can't inject; log into an X11 session")
    bad += 1
elif not sess and not disp:
    env("warn", "session", "headless (no XDG_SESSION_TYPE/DISPLAY) — injection needs an X11 desktop")
    bad += 1
else:
    env("ok", "session", f"{sess or 'x11'} (DISPLAY={disp or 'unset'})")
v = sys.version_info
env("ok" if v >= (3, 7) else "MISSING", f"python {v.major}.{v.minor}", "daemon needs 3.7+")
bad += 0 if v >= (3, 7) else 1
kf = os.path.expanduser("~/.config/wf/key")
try:
    m = os.stat(kf).st_mode & 0o777
    if m & 0o077:
        env("warn", "key perms", f"{kf} is {oct(m)[2:]} — fix: chmod 600 {kf}")
        bad += 1
    else:
        env("ok", "key perms", f"{kf} mode {oct(m)[2:]}")
except OSError:
    env("note", "key perms", "no key yet — created mode 600 on first `wrap start`")
sys.exit(1 if bad else 0)
PY
    ;;
*)
    echo "wrap — Flow Composer bridge (phone -> laptop cursor)
  wrap start     start daemon + show pair QR (scan = connected)
  wrap pair      show pair QR / one-shot code again
  wrap bridge    adb reverse (after replug)
  wrap tunnel    cloudflare tunnel + pair QR (works from anywhere)
  wrap doctor    verify dependencies (run this first)
  wrap status    daemon / port / rss / lan link / adb state
  wrap logs      daemon log (wrap logs -f to follow)
  wrap send TEXT type TEXT at laptop cursor
  wrap install   build + install Android app (optional)
  wrap open      launch app on phone
  wrap stop      stop daemon"
    ;;
esac
