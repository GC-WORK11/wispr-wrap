---
// Sign-Flow landing — light premium palette, system-ui.
interface Props { title: string; description: string }
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FCFCFC" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/media/screens/send.webp" as="image" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #fcfcfc;
    --surface: #ffffff;
    --surface-2: #eeeef0;
    --text: #0a0a0a;
    --muted: #888888;
    --faint: #bdbdbd;
    --border: #ebebeb;
    --pink: #ff309c;
    --pink-deep: #d81b7a;
    --pink-dark: #c2185b;
    --purple: #9259fe;
    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    --ease-spring: cubic-bezier(0.34, 1.4, 0.4, 1);
    --pad: clamp(20px, 4vw, 48px);
    --r-block: 28px;
    --shadow-soft: 0 2px 8px rgb(0 0 0 / 0.06), 0 1px 2px rgb(0 0 0 / 0.04);
    --shadow-lift: 0 1px 2px rgb(0 0 0 / 0.05), 0 18px 40px -18px rgb(0 0 0 / 0.22);
    --mono: ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Consolas, monospace;
  }
  * { box-sizing: border-box; }
  html {
    scroll-behavior: smooth;
    scrollbar-width: none;               /* hidden scrollbar, scroll stays */
    -webkit-text-size-adjust: 100%;
  }
  html::-webkit-scrollbar { display: none; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: Inter, system-ui, -apple-system, 'Segoe UI', sans-serif;
    font-size: 17px;
    line-height: 1.45;
    letter-spacing: -0.011em;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }
  ::selection { background: rgb(255 48 156 / 0.16); }
  h1, h2, p { margin: 0; }
  img { display: block; }
  button { font: inherit; color: inherit; }
  a { color: inherit; text-decoration: none; }

  .h2 {
    font-size: clamp(30px, 4.4vw, 52px);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.045em;
  }

  /* round white icon button — the shape language's atom */
  .rb {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 0;
    border-radius: 999px;
    background: var(--surface);
    box-shadow: var(--shadow-soft), inset 0 0 0 1px rgb(0 0 0 / 0.02);
    cursor: pointer;
    transition: transform 0.18s var(--ease-out), box-shadow 0.18s var(--ease-out);
  }
  .rb:hover { transform: translateY(-1px); box-shadow: var(--shadow-lift); }
  .rb:active { transform: translateY(0) scale(0.97); }
  .rb:disabled { opacity: 0.45; cursor: default; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after {
      animation-duration: 0.001s !important;
      animation-delay: 0s !important;
      transition-duration: 0.001s !important;
      transition-delay: 0s !important;
    }
  }
</style>
