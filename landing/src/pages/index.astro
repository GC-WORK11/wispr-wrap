---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Send from '../components/Send.astro';
import Teach from '../components/Teach.astro';
import Try from '../components/Try.astro';
import How from '../components/How.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Sign-Flow — your phone types, sends and signs on your laptop"
  description="Open a link on your phone and type, send photos and files, or teach hand signs that run on your laptop. The camera never leaves the phone — only hand keypoints do."
>
  <Hero />
  <main>
    <Send />
    <Teach />
    <Try />
    <How />
  </main>
  <Footer />
</Base>
