---
// How — one line grows across the board; the real steps sprout along it.
// Terminal cards carry the actual captured output of clone / npm install /
// wrap start (landing/src/data/terminal.json, key masked, QR re-rendered for
// the masked link). The phone screens are real app captures.
// No JS or reduced motion: everything visible, nothing moves.
import { layout } from '../lib/flow.mjs';
import term from '../data/terminal.json';

/* ---- QR: ANSI half-block art -> dark-module matrix -> SVG rects ---- */
const ANSI_CELL = /\x1b\[(\d+);(\d+)m(.)/g;
function qrRects(art) {
  const rects = [];
  const lines = art.split('\n');
  const dark = { 30: true, 40: true };
  let W = 0;
  lines.forEach((line, r) => {
    let x = 0, last = 0;
    for (const m of line.matchAll(ANSI_CELL)) {
      x += m.index - last;              // plain chars between runs = light cells
      const F = dark[+m[1]], B = dark[+m[2]], ch = m[3];
      const top = ch === '█' || ch === '▀' ? F : B;
      const bot = ch === '█' || ch === '▄' ? F : B;
      if (top) rects.push(`M${x} ${2 * r}h1v1h-1z`);
      if (bot) rects.push(`M${x} ${2 * r + 1}h1v1h-1z`);
      x++;
      last = m.index + m[0].length;
    }
    if (x > W) W = x;
  });
  return { d: rects.join(''), w: W, h: lines.length * 2 };
}
const qr = qrRects(term.qr);

/* ---- text tails (plain lines after the QR) ---- */
const stripAnsi = (s) => s.replace(/\x1b\[[0-9;]*m/g, '');
const outOf = (id) => stripAnsi(term.steps.find((s) => s.id === id)?.out ?? '');
const startTail = stripAnsi(term.steps.find((s) => s.id === 'start').out)
  .split('\n').filter((l) => l.trim()).slice(-3);

const CMD = Object.fromEntries(term.steps.map((s) => [s.id, s.cmd]));
const cloneOut = outOf('clone').trim();
const installOut = outOf('install').trim();

const PHONE = 390 / 844;
const nodes = {
  clone:   { kind: 'term', cmd: CMD.clone, out: cloneOut },
  install: { kind: 'term', cmd: CMD.install, out: installOut },
  start:   { kind: 'qr', cmd: CMD.start, tail: startTail },
  app:     { kind: 'img', src: '/media/screens/send.webp', alt: 'The composer open on the phone, text typed and sent' },
  live:    { kind: 'img', src: '/media/screens/live.webp', alt: 'Go Live: a sign just typed its word' },
};

const wide = layout({
  W: 1300, H: 780,
  start: [-30, 620], end: [1330, 130],
  boxes: [
    { id: 'clone', x: 40, y: 500, w: 316, ratio: 3.5 },
    { id: 'install', x: 322, y: 640, w: 300, ratio: 3.6 },
    { id: 'start', x: 500, y: 120, w: 316, ratio: 1.28 },
    { id: 'app', x: 806, y: 396, w: 200, ratio: PHONE },
    { id: 'live', x: 1030, y: 40, w: 200, ratio: PHONE },
  ],
});
const tall = layout({
  W: 400, H: 1560,
  start: [200, -30], end: [240, 1590],
  boxes: [
    { id: 'clone', x: 42, y: 40, w: 316, ratio: 3.5 },
    { id: 'install', x: 56, y: 176, w: 300, ratio: 3.6 },
    { id: 'start', x: 42, y: 316, w: 316, ratio: 1.28 },
    { id: 'app', x: 96, y: 620, w: 240, ratio: PHONE },
    { id: 'live', x: 84, y: 1100, w: 240, ratio: PHONE },
  ],
});
const tallById = Object.fromEntries(tall.nodes.map((n) => [n.id, n]));
---

<section class="how" id="how" aria-labelledby="how-t">
  <h2 id="how-t" class="h2">Clone to paired.</h2>

  <div class="board" data-flow style={`--wide-ar: ${wide.W} / ${wide.H}; --tall-ar: ${tall.W} / ${tall.H}`}>
    <div class="camera" data-camera>
      {[wide, tall].map((L, i) => (
        <svg class={`line line-${i ? 'tall' : 'wide'}`} viewBox={`0 0 ${L.W} ${L.H}`} aria-hidden="true" focusable="false">
          <defs>
            <mask id={`how-reveal-${i}`} maskUnits="userSpaceOnUse" x="-60" y="-60" width={L.W + 120} height={L.H + 120}>
              <path class="reveal" d={L.d} pathLength="1" fill="none" stroke="#fff" stroke-width="26" stroke-linecap="round" />
            </mask>
          </defs>
          <g mask={`url(#how-reveal-${i})`} fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d={L.d} class="dust" />
            <path d={L.d} class="edge" />
            <path d={L.d} class="body" />
            <path d={L.d} class="grain" />
          </g>
        </svg>
      ))}

      {wide.nodes.map((n) => {
        const t = tallById[n.id];
        const node = nodes[n.id];
        return (
          <figure
            class={`node node-${n.id}`}
            style={`--l:${n.left}; --tp:${n.top}; --w:${n.width}; --t:${n.t}; --tl:${t.left}; --ttp:${t.top}; --tw:${t.width}; --tt:${t.t}`}
          >
            {node.kind === 'img' && <img src={node.src} alt={node.alt} width="390" height="844" loading="lazy" decoding="async" />}
            {node.kind === 'term' && (
              <div class="tc">
                <p class="cmd"><span class="ps">$</span> {node.cmd}</p>
                <pre>{node.out}</pre>
              </div>
            )}
            {node.kind === 'qr' && (
              <div class="tc tc-qr">
                <p class="cmd"><span class="ps">$</span> {node.cmd}</p>
                <svg class="qr" viewBox={`-1 -1 ${qr.w + 2} ${qr.h + 2}`} role="img" aria-label="Pairing QR code">
                  <path d={qr.d} />
                </svg>
                <pre>{node.tail.join('\n')}</pre>
              </div>
            )}
          </figure>
        );
      })}
    </div>
  </div>
</section>

<script>
  const board = document.querySelector('[data-flow]');
  if (board && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    board.classList.add('is-armed');
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          board.classList.add('is-drawn');
          io.disconnect();
        }
      },
      { threshold: 0.12, rootMargin: '280px 0px' },
    );
    io.observe(board);
    let raf = 0;
    const syncScroll = () => {
      raf = 0;
      const rect = board.getBoundingClientRect();
      const vh = window.innerHeight || 900;
      const p = Math.max(-1, Math.min(1, (vh * 0.5 - (rect.top + rect.height * 0.5)) / (vh * 0.75)));
      board.style.setProperty('--scroll-pan', `${(p * -14).toFixed(2)}px`);
    };
    window.addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(syncScroll); }, { passive: true });
    syncScroll();
  }
</script>

<style>
  .how { padding: clamp(96px, 11vw, 168px) var(--pad) 0; }
  .how .h2 { max-width: 1160px; margin: 0 auto; }

  .board {
    --dur: 3.2s;
    --scroll-pan: 0px;
    position: sticky;
    top: clamp(16px, 3vh, 36px);
    max-width: 1300px;
    margin: clamp(32px, 3.6vw, 52px) auto 0;
    aspect-ratio: var(--wide-ar);
    border-radius: var(--r-block);
    background:
      radial-gradient(110% 80% at 20% 0%, rgb(255 48 156 / 0.05), transparent 55%),
      var(--surface);
    box-shadow: var(--shadow-soft), 0 0 0 1px var(--border);
    overflow: hidden;
    isolation: isolate;
  }
  .camera {
    position: absolute;
    inset: 0;
    transform: translate3d(0, var(--scroll-pan), 0);
    will-change: transform;
  }
  .line { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .line-tall { display: none; }

  /* a pink marker line: halo, broken edge, solid core, paper specks */
  .dust { stroke: var(--pink); stroke-width: 15; stroke-opacity: 0.05; }
  .edge {
    stroke: var(--pink); stroke-width: 7; stroke-opacity: 0.22; stroke-linecap: butt;
    stroke-dasharray: 3.1 1.7 0.9 2.3 5.3 1.1 1.9 3.7 0.7 1.3 7.9 2.9;
  }
  .body {
    stroke: var(--pink); stroke-width: 3.6; stroke-opacity: 0.92;
    stroke-dasharray: 47 0.6 13 1.3 29 0.4 71 2.1 17 0.8;
  }
  .grain {
    stroke: var(--surface); stroke-width: 1.2; stroke-opacity: 0.6;
    stroke-dasharray: 0.4 11.3 0.7 5.9 0.3 17.1 0.6 7.7;
  }
  .reveal { stroke-dasharray: 1 1; stroke-dashoffset: 0; }

  .node {
    position: absolute;
    left: var(--l);
    top: var(--tp);
    width: var(--w);
    z-index: 1;
    margin: 0;
    border-radius: 16px;
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--shadow-lift), 0 0 0 1px var(--border);
  }
  .node img { width: 100%; height: auto; }

  .tc { padding: 14px 16px; font-family: var(--mono); font-size: 11.5px; line-height: 1.5; }
  .tc .cmd { font-weight: 600; color: var(--text); }
  .tc .ps { color: var(--pink); }
  .tc pre {
    margin: 6px 0 0;
    white-space: pre-wrap;
    word-break: break-all;
    color: var(--muted);
    font-size: 10.5px;
  }
  .qr {
    display: block;
    width: 128px;
    margin: 8px auto 4px;
    fill: var(--text);
    shape-rendering: crispEdges;
  }

  @keyframes camera-follow {
    0% { transform: translate3d(1.6%, 1%, 0) scale(1.018); }
    40% { transform: translate3d(0.4%, -1%, 0) scale(1.015); }
    72% { transform: translate3d(-1.4%, 0.8%, 0) scale(1.014); }
    100% { transform: translate3d(0, var(--scroll-pan), 0) scale(1); }
  }

  :global(.js) .is-armed .reveal { stroke-dashoffset: 1; }
  :global(.js) .is-armed .node { opacity: 0; transform: translateY(18px) scale(0.94); }
  :global(.js) .is-armed.is-drawn .camera { animation: camera-follow 3.4s var(--ease-out) both; }
  :global(.js) .is-armed.is-drawn .reveal {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset var(--dur) cubic-bezier(0.45, 0.05, 0.25, 1);
  }
  :global(.js) .is-armed.is-drawn .node {
    opacity: 1;
    transform: none;
    transition: opacity 0.45s var(--ease-out), transform 0.7s var(--ease-spring);
    transition-delay: calc(var(--t) * var(--dur) - 0.12s);
  }

  @media (max-width: 999px) {
    .board { position: relative; top: auto; aspect-ratio: var(--tall-ar); max-width: 460px; }
    :global(.js) .is-armed.is-drawn .camera { animation: none; }
    .line-wide { display: none; }
    .line-tall { display: block; }
    .node { left: var(--tl); top: var(--ttp); width: var(--tw); }
    :global(.js) .is-armed.is-drawn .node { transition-delay: calc(var(--tt) * var(--dur) - 0.12s); }
  }
</style>
