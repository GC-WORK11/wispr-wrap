---
// Teach — three real loops from the running app: pick the action, record
// three takes, done. Muted autoplay playsinline; no-JS shows the poster.
const shots = [
  { src: '/media/loops/teach-pick.mp4', alt: 'Teach a sign: pick what it does — Type text is chosen' },
  { src: '/media/loops/teach-take.mp4', alt: 'Recording a take: the hand-landmark overlay tracks the sign, take two of three' },
  { src: '/media/loops/teach-done.mp4', alt: 'The sign is saved and live' },
];
---

<section class="teach" aria-labelledby="teach-t">
  <h2 id="teach-t" class="h2">Teach a sign in ten seconds.</h2>
  <div class="row">
    {shots.map((s) => (
      <figure>
        <video src={s.src} poster={s.src.replace('.mp4', '.jpg')} width="390" height="844"
               muted autoplay loop playsinline preload="metadata" aria-label={s.alt}></video>
      </figure>
    ))}
  </div>
</section>

<style>
  .teach {
    padding: clamp(80px, 10vw, 150px) var(--pad) 0;
    max-width: 1160px;
    margin: 0 auto;
  }
  .row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(14px, 2.4vw, 32px);
    margin-top: clamp(28px, 4vw, 56px);
  }
  figure {
    margin: 0;
    border-radius: 20px;
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--shadow-lift), 0 0 0 1px var(--border);
  }
  figure img, figure video { width: 100%; height: auto; display: block; }
  figure:nth-child(2) { translate: 0 clamp(10px, 2vw, 28px); }
  @media (max-width: 760px) {
    .row { grid-template-columns: 1fr 1fr; }
    figure:nth-child(2) { translate: 0; }
    figure:last-child { grid-column: 1 / -1; max-width: 60%; margin: 0 auto; }
  }
</style>
