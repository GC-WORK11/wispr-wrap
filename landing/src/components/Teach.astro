---
// Teach — three real 390x844 recordings: name it, record three takes, done.
const shots = [
  { id: 'teach-pick', alt: 'Teach a sign: name it and start recording' },
  { id: 'teach-take', alt: 'Recording takes: the app reads your hands, three takes' },
  { id: 'teach-done', alt: 'Bind what it does — the sign is saved and live' },
];
---

<section class="teach" aria-labelledby="teach-t">
  <h2 id="teach-t" class="h2">Teach a sign in ten seconds.</h2>
  <div class="row">
    {shots.map((s) => (
      <figure>
        <video autoplay muted loop playsinline preload="auto" width="390" height="844"
          poster={`/media/clips/${s.id}-poster.png`} data-loop aria-label={s.alt}>
          <source src={`/media/clips/${s.id}.webm`} type="video/webm" />
          <source src={`/media/clips/${s.id}.mp4`} type="video/mp4" />
        </video>
      </figure>
    ))}
  </div>
</section>

<style>
  .teach {
    padding: clamp(80px, 10vw, 150px) var(--pad) 0;
    max-width: 1160px;
    margin: 0 auto;
  }
  .row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(14px, 2.4vw, 32px);
    margin-top: clamp(28px, 4vw, 56px);
  }
  figure {
    margin: 0;
    border-radius: 20px;
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--shadow-lift), 0 0 0 1px var(--border);
  }
  figure img, figure video { display: block; width: 100%; height: auto; }
  figure:nth-child(2) { translate: 0 clamp(10px, 2vw, 28px); }
  @media (max-width: 760px) {
    .row { grid-template-columns: 1fr 1fr; }
    figure:nth-child(2) { translate: 0; }
    figure:last-child { grid-column: 1 / -1; max-width: 60%; margin: 0 auto; }
  }
</style>
