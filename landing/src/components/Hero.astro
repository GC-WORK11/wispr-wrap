---
// Hero — the tonal ASCII lotus blooms on load (same petals/tones as the app's
// flower), the pink blob mark above it, one concrete line. No-JS: a bloomed
// static frame renders server-side.
import { createLotus, LOTUS_TONES } from '../lib/lotus.mjs';
import { REPO_URL } from '../lib/repo.mjs';
const L = createLotus({ cols: 62, rows: 33, cw: 9, lh: 14 });
const still = L.frame(1.2, 1); // bloomed, gently mid-sway
---

<header class="hero">
  <div class="bar">
    <a class="mark" href="/" aria-label="Sign-Flow home">
      <img src="/icon.svg" width="34" height="34" alt="" />
      <span>Sign-Flow</span>
    </a>
    <nav class="nav">
      <a href="#try">Try</a>
      <a href="#how">Set up</a>
      <a class="gh" href={REPO_URL} aria-label="Sign-Flow on GitHub" target="_blank" rel="noopener">
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
      </a>
    </nav>
  </div>

  <div class="lotus" data-lotus aria-hidden="true">
    {still.map((txt, i) => <pre class={`t${i}`}>{txt}</pre>)}
  </div>

  <div class="hero-foot">
    <h1 class="hero-line">Type and control your laptop without touching it.</h1>
    <div class="phone" aria-hidden="true">
      <video autoplay muted loop playsinline preload="auto" poster="/media/clips/live-poster.png"
        data-loop title="Go Live: a signed command types on the laptop">
        <source src="/media/clips/live.webm" type="video/webm" />
        <source src="/media/clips/live.mp4" type="video/mp4" />
      </video>
    </div>
  </div>
</header>

<script>
  import { createLotus, LOTUS_TONES } from '../lib/lotus.mjs';
  const el = document.querySelector('[data-lotus]');
  if (el && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const layers = [...el.querySelectorAll('pre')];
    // fit the grid to the rendered box
    const cw = 9, lh = 14;
    const cols = Math.max(40, Math.floor(el.clientWidth / cw) - 1);
    const rows = Math.max(24, Math.floor(el.clientHeight / lh) - 1);
    const L = createLotus({ cols, rows, cw, lh });
    layers.forEach((p, i) => (p.style.color = LOTUS_TONES[i]));
    const T0 = performance.now();
    let last = -1;
    const tick = (now) => {
      const t = (now - T0) / 1000;
      // bloom eases open over ~2.2s, then the flower keeps breathing
      const bloom = Math.min(1, t / 2.2);
      const b = 1 - Math.pow(1 - bloom, 3);
      if (t - last > 1 / 30) {
        last = t;
        const fr = L.frame(t + 1.2, b);
        layers.forEach((p, i) => { p.textContent = fr[i]; });
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
</script>

<style>
  .hero {
    min-height: min(96vh, 980px);
    display: flex;
    flex-direction: column;
    padding: clamp(16px, 2.4vw, 28px) var(--pad) 0;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 17px;
    letter-spacing: -0.02em;
  }
  .nav { display: flex; align-items: center; gap: clamp(16px, 2.6vw, 34px); font-size: 15px; color: var(--muted); }
  .nav a:hover { color: var(--text); }
  .nav .gh { display: inline-flex; align-items: center; }

  .lotus {
    position: relative;
    flex: 1;
    min-height: 320px;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .lotus pre {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    margin: 0;
    font-family: var(--mono);
    font-size: 14px;
    line-height: 14px;
    letter-spacing: 0;
    white-space: pre;
    user-select: none;
  }
  .lotus .t0 { color: #c2185b; }
  .lotus .t1 { color: #e91e8c; }
  .lotus .t2 { color: #ff309c; }
  .lotus .t3 { color: #ff6fb8; }
  .lotus .t4 { color: #ffb3d9; }

  .hero-foot {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(24px, 4.5vw, 64px);
    padding: 0 var(--pad) clamp(48px, 6vw, 88px);
  }
  .hero-line {
    font-size: clamp(26px, 3.6vw, 44px);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.06;
    text-align: center;
    max-width: 22ch;
    margin: 0;
  }
  .phone {
    flex: none;
    width: clamp(96px, 11vw, 148px);
    border-radius: 18px;
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--shadow-lift), 0 0 0 1px var(--border);
    rotate: 2deg;
  }
  .phone video { display: block; width: 100%; height: auto; aspect-ratio: 390 / 844; }

  @media (max-width: 700px) {
    .lotus pre { font-size: 12px; line-height: 12px; }
    .hero-foot { flex-direction: column; }
    .phone { width: clamp(84px, 26vw, 120px); }
  }
</style>
