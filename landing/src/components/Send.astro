---
// Send — the composer, mid-send. Real app screen (390x844 capture).
---

<section class="send" aria-labelledby="send-t">
  <h2 id="send-t" class="h2">Text, photos, files.</h2>
  <div class="shot">
    <img src="/media/screens/send.webp" width="390" height="844" alt="The Sign-Flow composer on a phone: typed text with the send arrow lit" loading="lazy" decoding="async" />
  </div>
</section>

<style>
  .send {
    padding: clamp(80px, 10vw, 150px) var(--pad) 0;
    display: grid;
    grid-template-columns: 1fr minmax(240px, 360px);
    gap: clamp(28px, 6vw, 96px);
    align-items: center;
    max-width: 1160px;
    margin: 0 auto;
  }
  .shot {
    border-radius: 24px;
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--shadow-lift), 0 0 0 1px var(--border);
  }
  .shot img { width: 100%; height: auto; }
  @media (max-width: 760px) {
    .send { grid-template-columns: 1fr; }
    .shot { max-width: 340px; }
  }
</style>
