---
// Send — the composer, mid-send. Real 390x844 screen recording.
---

<section class="send" aria-labelledby="send-t">
  <h2 id="send-t" class="h2">Text, photos, files.</h2>
  <div class="shot">
    <video autoplay muted loop playsinline preload="auto" width="390" height="844"
      poster="/media/clips/send-poster.png" data-loop
      aria-label="The Sign-Flow composer on a phone: text typed, sent, and confirmed">
      <source src="/media/clips/send.webm" type="video/webm" />
      <source src="/media/clips/send.mp4" type="video/mp4" />
    </video>
  </div>
</section>

<style>
  .send {
    padding: clamp(80px, 10vw, 150px) var(--pad) 0;
    display: grid;
    grid-template-columns: 1fr minmax(240px, 360px);
    gap: clamp(28px, 6vw, 96px);
    align-items: center;
    max-width: 1160px;
    margin: 0 auto;
  }
  .shot {
    border-radius: 24px;
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--shadow-lift), 0 0 0 1px var(--border);
  }
  .shot video { display: block; width: 100%; height: auto; }
  @media (max-width: 760px) {
    .send { grid-template-columns: 1fr; }
    .shot { max-width: 340px; }
  }
</style>
